---
import { getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import AlbumShelf from '../components/AlbumShelf.astro';
import heroSource from '../assets/hero.png';
import raw from '../data/youtube.json';
import { buildCatalog } from '../lib/catalog.js';
import { activeLinks } from '../lib/links.js';

// ヒーロー画像はビルド時にwebpへ変換・縮小する（元は900x1600の1.3MB）
const hero = await getImage({ src: heroSource, format: 'webp', width: 900, quality: 78 });

// PC用の横長カット。src/assets/hero-desktop.（jpg|jpeg|png|webp）を置くと自動で使われる。
// 未配置ならスマホ用画像にフォールバックするので、ビルドは壊れない。
const desktopCandidates = import.meta.glob('../assets/hero-desktop.{jpg,jpeg,png,webp}', {
  eager: true,
  import: 'default',
});
const heroDesktopSource = Object.values(desktopCandidates)[0] ?? null;
const heroDesktop = heroDesktopSource
  ? await getImage({ src: heroDesktopSource, format: 'webp', width: 1920, quality: 78 })
  : null;

const heroStyle = [
  `--hero-image: url(${hero.src})`,
  `--hero-image-desktop: url(${(heroDesktop ?? hero).src})`,
].join('; ');

const { albums } = buildCatalog(raw);
const links = activeLinks();
// ヒーローの再生ボタンは最新のアルバム
const tonight = albums[0];
const tonightPlay = tonight ? `${tonight.kind ?? 'video'}:${tonight.id}` : '';
---

<BaseLayout>
  <main>
    <section class="hero">
      <div class="hero__art" style={heroStyle}></div>
      <div class="container hero__body">
        <p class="hero__label">A J-POP BALLAD PROJECT</p>
        <h1 class="hero__brand">NOWA MUSIC</h1>
        <p class="hero__copy">眠れない夜に、<br />ひとつの恋の物語を。</p>
        {tonight && (
          <button class="hero__play" type="button" data-play={tonightPlay} data-title={tonight.title}>
            <span>今夜の1枚を聴く</span>
            <span class="hero__play-arrow" aria-hidden="true">→</span>
          </button>
        )}
      </div>
      <p class="hero__meta" aria-hidden="true">TOKYO · NIGHT · <span id="hero-clock"></span></p>
      <div class="hero__scroll" aria-hidden="true"><span>SCROLL</span></div>
    </section>

    <section class="section words">
      <div class="container">
        <p class="reveal">言えないまま、終わってしまった恋がある。</p>
        <p class="reveal">忘れたはずの名前が、ふいに浮かぶ夜がある。</p>
        <p class="reveal">その気持ちに、そっと歌をつけています。</p>
      </div>
    </section>

    {albums.length > 0 && (
      <section class="section" id="albums">
        <div class="container reveal">
          <div class="section__head">
            <p class="section__label">ALBUM</p>
            <h2 class="section__title">眠りにつくまでの時間に、そっと。</h2>
          </div>
          <AlbumShelf albums={albums} limit={8} />
          {albums.length > 8 && <p class="more"><a href="/music/">すべてのアルバムを見る</a></p>}
        </div>
      </section>
    )}

    <section class="section" id="about">
      <div class="container reveal about">
        <div class="section__head">
          <p class="section__label">ABOUT</p>
          <h2 class="section__title">Nowa について</h2>
        </div>
        <p>眠れない夜、疲れた夜、ひとりで過ごす時間に。<br />オリジナルの単曲と、ゆっくり流せる1時間のプレイリストをお届けしています。</p>
        <p class="more"><a href="/about/">もっと読む</a></p>
      </div>
    </section>

    {links.length > 0 && (
      <section class="section" id="listen">
        <div class="container reveal">
          <div class="section__head">
            <p class="section__label">LISTEN</p>
            <h2 class="section__title">聴けるところ</h2>
          </div>
          <ul class="listen">
            {links.map((link) => (
              <li>
                <a href={link.url} target="_blank" rel="noopener">
                  <span>{link.label}</span>
                  <span class="listen__arrow" aria-hidden="true">↗</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}
  </main>
</BaseLayout>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    padding-block: 9rem 7rem;
    overflow: hidden;
  }
  .hero__art {
    position: absolute;
    inset: 0;
    /* --hero-image / --hero-image-desktop は上のインラインstyleで最適化済み画像のURLが入る。
       画像を外した場合は none に落ちてグラデーションだけが残る。 */
    background-image:
      linear-gradient(180deg, var(--hero-scrim-near) 0%, var(--hero-scrim-far) 55%, var(--bg-deep) 100%),
      var(--hero-image, none);
    background-size: cover;
    background-position: center 20%;
  }
  /* 横長のPC幅では縦長写真の上下が大きく切られ、顔が上に寄って暗く沈む。
     暗幕をコピーの乗る左下だけに寄せ、顔のある中央〜右上は薄くする。 */
  @media (min-width: 48rem) {
    .hero__art {
      background-image:
        linear-gradient(180deg, var(--hero-scrim-none) 62%, var(--bg-deep) 100%),
        linear-gradient(
          to top right,
          var(--hero-scrim-strong) 0%,
          var(--hero-scrim-mid) 45%,
          var(--hero-scrim-soft) 100%
        ),
        var(--hero-image-desktop, var(--hero-image, none));
      background-position: center 25%;
    }
  }
  .hero__body { position: relative; }
  .hero__label {
    font-family: var(--font-display);
    font-size: 0.8rem;
    letter-spacing: 0.36em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 1.75rem;
  }
  .hero__brand {
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 11vw, 8rem);
    font-weight: 300;
    line-height: 1;
    letter-spacing: 0.02em;
    margin: 0 0 1.75rem;
  }
  .hero__copy {
    font-size: clamp(1.05rem, 3.4vw, 1.5rem);
    font-weight: 300;
    line-height: 2;
    margin: 0 0 2.75rem;
  }
  .hero__play {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    min-width: min(16rem, 100%);
    padding: 1rem 1.5rem;
    border: 1px solid var(--line);
    background: none;
    color: var(--text);
    font: inherit;
    font-size: 0.85rem;
    letter-spacing: 0.16em;
    cursor: pointer;
    transition: border-color 0.5s ease, color 0.5s ease;
  }
  .hero__play:hover,
  .hero__play:focus-visible { border-color: var(--accent); color: var(--accent); }
  .hero__play-arrow { transition: transform 0.5s ease; }
  .hero__play:hover .hero__play-arrow { transform: translateX(0.25rem); }

  /* 右端の縦書き。狭い画面では幅を圧迫するので出さない */
  .hero__meta {
    display: none;
    position: absolute;
    right: 1.25rem;
    bottom: 7rem;
    margin: 0;
    writing-mode: vertical-rl;
    font-family: var(--font-display);
    font-size: 0.7rem;
    letter-spacing: 0.3em;
    color: var(--text-dim);
  }
  @media (min-width: 48rem) {
    .hero__meta { display: block; }
  }

  .hero__scroll {
    position: absolute;
    left: 50%;
    bottom: 1.25rem;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-display);
    font-size: 0.65rem;
    letter-spacing: 0.3em;
    color: var(--text-dim);
  }
  .hero__scroll::after {
    content: "";
    width: 1px;
    height: 3rem;
    background: var(--line);
    animation: scroll-hint 2.8s ease-in-out infinite;
  }
  @keyframes scroll-hint {
    0%, 100% { opacity: 0.3; transform: scaleY(0.6); transform-origin: top; }
    50% { opacity: 1; transform: scaleY(1); transform-origin: top; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__scroll::after { animation: none; opacity: 0.6; }
  }

  .words { text-align: center; padding-block: clamp(6rem, 16vw, 11rem); }
  .words p {
    font-size: clamp(1.1rem, 4vw, 1.5rem);
    line-height: 2.6;
    margin: 0 0 2rem;
  }
  .words p:nth-child(2) { transition-delay: 0.15s; }
  .words p:nth-child(3) { transition-delay: 0.3s; }

  .about p { max-width: 34rem; }
</style>

<script>
  // 右端の縦書きに閲覧者の現在時刻を出す。JSが動かない環境では時刻だけ出ない。
  const clock = document.getElementById('hero-clock');
  if (clock) {
    const render = () => {
      const now = new Date();
      const hh = String(now.getHours()).padStart(2, '0');
      const mm = String(now.getMinutes()).padStart(2, '0');
      clock.textContent = `${hh}:${mm}`;
    };
    render();
    setInterval(render, 30000);
  }
</script>
