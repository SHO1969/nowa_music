---
import { getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import AlbumShelf from '../components/AlbumShelf.astro';
import heroSource from '../assets/hero.png';
import raw from '../data/youtube.json';
import { buildCatalog } from '../lib/catalog.js';
import { activeLinks } from '../lib/links.js';

// ヒーロー画像はビルド時にwebpへ変換・縮小する（元は900x1600の1.3MB）
const hero = await getImage({ src: heroSource, format: 'webp', width: 900, quality: 78 });

// PC用の横長カット。src/assets/hero-desktop.（jpg|jpeg|png|webp）を置くと自動で使われる。
// 未配置ならスマホ用画像にフォールバックするので、ビルドは壊れない。
const desktopCandidates = import.meta.glob('../assets/hero-desktop.{jpg,jpeg,png,webp}', {
  eager: true,
  import: 'default',
});
const heroDesktopSource = Object.values(desktopCandidates)[0] ?? null;
const heroDesktop = heroDesktopSource
  ? await getImage({ src: heroDesktopSource, format: 'webp', width: 1920, quality: 78 })
  : null;

const heroStyle = [
  `--hero-image: url(${hero.src})`,
  `--hero-image-desktop: url(${(heroDesktop ?? hero).src})`,
].join('; ');

const { albums } = buildCatalog(raw);
const links = activeLinks();
// ヒーローの再生ボタンは最新のアルバム
const tonight = albums[0];
const tonightPlay = tonight ? `${tonight.kind ?? 'video'}:${tonight.id}` : '';
---

<BaseLayout>
  <main>
    <section class="hero">
      <div class="hero__art" style={heroStyle}></div>
      <div class="container hero__body">
        <p class="hero__label">NOWA MUSIC</p>
        <h1 class="hero__copy">夜が、<br />ひとりを<br />やさしくする。</h1>
        {tonight && (
          <button class="hero__play" type="button" data-play={tonightPlay} data-title={tonight.title}>
            ▶ 今夜の1枚
          </button>
        )}
      </div>
    </section>

    <section class="section words">
      <div class="container">
        <p class="reveal">言えないまま、終わってしまった恋がある。</p>
        <p class="reveal">忘れたはずの名前が、ふいに浮かぶ夜がある。</p>
        <p class="reveal">その気持ちに、そっと歌をつけています。</p>
      </div>
    </section>

    {albums.length > 0 && (
      <section class="section" id="albums">
        <div class="container reveal">
          <p class="section__label">ALBUM</p>
          <h2 class="section__title">眠りにつくまでの時間に、そっと。</h2>
          <AlbumShelf albums={albums} limit={8} />
          {albums.length > 8 && <p class="more"><a href="/music/">すべてのアルバムを見る</a></p>}
        </div>
      </section>
    )}

    <section class="section" id="about">
      <div class="container reveal about">
        <p class="section__label">ABOUT</p>
        <h2 class="section__title">Nowa について</h2>
        <p>眠れない夜、疲れた夜、ひとりで過ごす時間に。<br />オリジナルの単曲と、ゆっくり流せる1時間のプレイリストをお届けしています。</p>
        <p class="more"><a href="/about/">もっと読む</a></p>
      </div>
    </section>

    {links.length > 0 && (
      <section class="section" id="listen">
        <div class="container reveal">
          <p class="section__label">LISTEN</p>
          <h2 class="section__title">聴けるところ</h2>
          <ul class="listen">
            {links.map((link) => (
              <li><a href={link.url} target="_blank" rel="noopener">{link.label}</a></li>
            ))}
          </ul>
        </div>
      </section>
    )}
  </main>
</BaseLayout>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    padding-block: 8rem 4rem;
    overflow: hidden;
  }
  .hero__art {
    position: absolute;
    inset: 0;
    /* --hero-image / --hero-image-desktop は上のインラインstyleで最適化済み画像のURLが入る。
       画像を外した場合は none に落ちてグラデーションだけが残る。 */
    background-image:
      linear-gradient(180deg, var(--hero-scrim-near) 0%, var(--hero-scrim-far) 55%, var(--bg-deep) 100%),
      var(--hero-image, none);
    background-size: cover;
    background-position: center 20%;
  }
  /* 横長のPC幅では縦長写真の上下が大きく切られ、顔が上に寄って暗く沈む。
     暗幕をコピーの乗る左下だけに寄せ、顔のある中央〜右上は薄くする。 */
  @media (min-width: 48rem) {
    .hero__art {
      background-image:
        linear-gradient(180deg, var(--hero-scrim-none) 62%, var(--bg-deep) 100%),
        linear-gradient(
          to top right,
          var(--hero-scrim-strong) 0%,
          var(--hero-scrim-mid) 45%,
          var(--hero-scrim-soft) 100%
        ),
        var(--hero-image-desktop, var(--hero-image, none));
      background-position: center 25%;
    }
  }
  .hero__body { position: relative; }
  .hero__label {
    font-size: 0.68rem;
    letter-spacing: 0.36em;
    color: var(--accent);
    margin: 0 0 1.5rem;
  }
  .hero__copy {
    font-size: clamp(1.9rem, 8vw, 3.2rem);
    font-weight: 200;
    line-height: 1.8;
    margin: 0 0 2.5rem;
  }
  .hero__play {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.85rem 1.8rem;
    border: 1px solid var(--accent);
    border-radius: 999px;
    background: none;
    color: var(--text);
    font: inherit;
    font-size: 0.8rem;
    letter-spacing: 0.18em;
    cursor: pointer;
    transition: background 0.5s ease, color 0.5s ease;
  }
  .hero__play:hover { background: var(--accent); color: var(--bg-deep); }

  .words { text-align: center; }
  .words p {
    font-size: clamp(1rem, 3.6vw, 1.25rem);
    line-height: 2.4;
    margin: 0 0 1.5rem;
  }
  .words p:nth-child(2) { transition-delay: 0.15s; }
  .words p:nth-child(3) { transition-delay: 0.3s; }

  .more { margin-top: 2.5rem; font-size: 0.78rem; letter-spacing: 0.18em; }
  .more a { color: var(--accent); border-bottom: 1px solid var(--line); padding-bottom: 0.2rem; }

  .about p { max-width: 34rem; }

  .listen {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2.5rem;
    font-size: 0.85rem;
    letter-spacing: 0.16em;
  }
  .listen a { border-bottom: 1px solid var(--line); padding-bottom: 0.25rem; }
  .listen a:hover { color: var(--accent); }
</style>
