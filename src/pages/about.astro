---
import { getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import portraitSource from '../assets/portrait.png';
import { activeLinks } from '../lib/links.js';

const links = activeLinks();

// プロフィール情報。項目が増減してもレイアウトはそのまま追随する。
const PROFILE_FACTS = [
  { label: 'ジャンル', value: 'J-POP / バラード / 女性ボーカル' },
  { label: '活動開始', value: '2025年8月' },
  { label: '配信', value: 'Spotify / Apple Music / YouTube Music ほか' },
  { label: '更新', value: '毎週月曜 21:00（アルバム）/ 随時（単曲）' },
];
// 人物写真はビルド時にwebpへ変換・縮小する（元は1500x2000の2.2MB）
const portrait = await getImage({ src: portraitSource, format: 'webp', width: 900, quality: 78 });
---

<BaseLayout title="ABOUT" description="Nowa Music について。夜にそっと寄り添う、女性ボーカルのJ-POPバラード。">
  <main>
    <section class="section head">
      <div class="container">
        <p class="section__label">ABOUT</p>
        <h1 class="section__title">Nowa</h1>
      </div>
    </section>

    <section class="section">
      <div class="container profile">
        <div class="profile__art reveal" style={`--profile-image: url(${portrait.src})`}></div>
        <div class="profile__text reveal">
          <p>Nowa（ノワ）は、ひとりの夜に聴く歌をつくっています。</p>
          <p>歌にしているのは、言えなかった気持ちのことです。<br />あの時こう言えていたら、あの時こうしていたら。<br />そんな「もしも」を、誰もがひとつは持っていると思います。</p>
          <p>時間が経つほど、その気持ちは消えるどころか、<br />かたちを変えて、静かに残り続けます。<br />仕事を終えて、部屋の明かりを落とした夜。<br />ふいに、あの頃の景色が戻ってくることがあります。</p>
          <p>Nowaの歌は、その時間のためにあります。</p>
          <p>忘れなくていい。<br />無理に前を向かなくてもいい。<br />ただ、その気持ちのそばに、音楽があればいい。</p>
          <p>そう思いながら、一曲ずつ作っています。</p>
          <p>オリジナルの楽曲と、<br />夜のあいだ流し続けられる1時間のプレイリストを、<br />毎週お届けしています。</p>
          <p>今夜も、どうか穏やかな時間になりますように。</p>

          <dl class="facts">
            {PROFILE_FACTS.map((fact) => (
              <div class="facts__row">
                <dt>{fact.label}</dt>
                <dd>{fact.value}</dd>
              </div>
            ))}
          </dl>
        </div>
      </div>
    </section>

    {links.length > 0 && (
      <section class="section">
        <div class="container reveal">
          <p class="section__label">LISTEN</p>
          <ul class="listen">
            {links.map((link) => (
              <li><a href={link.url} target="_blank" rel="noopener">{link.label}</a></li>
            ))}
          </ul>
        </div>
      </section>
    )}
  </main>
</BaseLayout>

<style>
  .head { padding-top: 9rem; }
  .profile {
    display: grid;
    gap: 3rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 48rem) {
    .profile { grid-template-columns: 1fr 1.2fr; gap: 4rem; align-items: start; }
  }
  .profile__art {
    aspect-ratio: 3 / 4;
    border: 1px solid var(--line);
    /* --profile-image は上のインラインstyleで最適化済み画像のURLが入る。
       画像を外した場合は下のグラデーションだけが残る。 */
    background:
      linear-gradient(180deg, var(--profile-scrim-near), var(--profile-scrim-far)),
      var(--profile-image, none),
      linear-gradient(140deg, var(--bg-mid), var(--bg-far));
    background-size: cover;
    background-position: center;
  }
  .profile__text p { margin: 0 0 2rem; }

  /* プロフィール情報。控えめな罫線で区切る */
  .facts {
    margin: 3.5rem 0 0;
    padding-top: 2rem;
    border-top: 1px solid var(--line);
  }
  .facts__row {
    display: grid;
    grid-template-columns: 6rem 1fr;
    gap: 0 1.5rem;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--line);
  }
  .facts dt {
    font-size: 0.72rem;
    letter-spacing: 0.2em;
    color: var(--accent);
    line-height: 2.2;
  }
  .facts dd {
    margin: 0;
    font-size: 0.85rem;
    line-height: 2;
  }
  @media (max-width: 26rem) {
    .facts__row { grid-template-columns: 1fr; gap: 0.2rem; }
  }
  .listen {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2.5rem;
    font-size: 0.85rem;
    letter-spacing: 0.16em;
  }
  .listen a { border-bottom: 1px solid var(--line); padding-bottom: 0.25rem; }
  .listen a:hover { color: var(--accent); }
</style>
